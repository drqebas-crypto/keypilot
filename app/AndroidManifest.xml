<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.qebas.kbdriver"
    android:versionCode="22" android:versionName="5.0.10">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Development protection level: NOT granted at install. A
         one-time `pm grant` (adb) lets the service write the secure
         settings it owns (its accessibility list membership) with
         no Shizuku in the loop - step 4 phase 3, 2026-11-06. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- Package visibility (Android 11+): without these, the service
         cannot see the apps it must foreground and
         getLaunchIntentForPackage returns null for all of them
         (proven live 2026-11-06: LAUNCH failed no-launch-intent for
         claude, termux and whatsapp alike). The list mirrors the
         daemon's ALLOW set plus the owner's restore targets. -->
    <queries>
        <package android:name="com.anthropic.claude" />
        <package android:name="com.termux" />
        <package android:name="com.whatsapp" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.moonshot.kimichat" />
        <package android:name="ai.qwenlm.chat.android" />
    </queries>

    <application
        android:label="KB Driver"
        android:allowBackup="false">

        <service
            android:name=".KbService"
            android:label="KB Driver"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kb_accessibility" />
        </service>
    </application>
</manifest>
